<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/table"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="8dp"
    android:paddingEnd="8dp"
    android:paddingBottom="8dp">

    <!-- Fejléc: oszlopcímek + frissítés gomb -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:text="@string/source_short"
            android:textColor="@color/w_label"
            android:textSize="10sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="@string/buy"
            android:textColor="@color/w_label"
            android:textSize="11sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="@string/sell"
            android:textColor="@color/w_label"
            android:textSize="11sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="@string/mnb_short"
            android:textColor="@color/w_mid"
            android:textSize="11sp" />

        <ImageView
            android:id="@+id/refresh"
            android:layout_width="28dp"
            android:layout_height="22dp"
            android:contentDescription="@string/refresh"
            android:paddingStart="8dp"
            android:src="@drawable/ic_refresh" />
    </LinearLayout>

    <!-- EUR kiemelve -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:text="EUR"
            android:textColor="@color/w_accent"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/eur_buy"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="–"
            android:textColor="@color/w_text"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/eur_sell"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="–"
            android:textColor="@color/w_text"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/eur_mid"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="–"
            android:textColor="@color/w_mid"
            android:textSize="18sp" />

        <TextView
            android:layout_width="28dp"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="3dp"
        android:layout_marginEnd="28dp"
        android:layout_marginBottom="3dp"
        android:background="@color/w_divider"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:text="USD"
            android:textColor="@color/w_label"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/usd_buy"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="–"
            android:textColor="@color/w_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/usd_sell"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="–"
            android:textColor="@color/w_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/usd_mid"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="–"
            android:textColor="@color/w_mid"
            android:textSize="14sp" />

        <TextView
            android:layout_width="28dp"
            android:layout_height="wrap_content" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:text="CHF"
            android:textColor="@color/w_label"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/chf_buy"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="–"
            android:textColor="@color/w_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/chf_sell"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="–"
            android:textColor="@color/w_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/chf_mid"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="–"
            android:textColor="@color/w_mid"
            android:textSize="14sp" />

        <TextView
            android:layout_width="28dp"
            android:layout_height="wrap_content" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:text="RSD"
            android:textColor="@color/w_label"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/rsd_buy"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="–"
            android:textColor="@color/w_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/rsd_sell"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="–"
            android:textColor="@color/w_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/rsd_mid"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="–"
            android:textColor="@color/w_mid"
            android:textSize="14sp" />

        <TextView
            android:layout_width="28dp"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <TextView
        android:id="@+id/updated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="6dp"
        android:gravity="end"
        android:text="@string/no_data"
        android:textColor="@color/w_label"
        android:textSize="10sp" />
</LinearLayout>
